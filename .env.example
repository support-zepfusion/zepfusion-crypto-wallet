# Public JSON-RPC and TronGrid endpoints for read-only balance checks.
# Do not put an API key or a private key here. Do not commit a filled-in .env.
#
# The signer builds and broadcasts only on Sepolia (chain id 11155111).
# Every other URL below is refused for signing even if a node answers.

COFINEX_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
COFINEX_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
COFINEX_BSC_RPC_URL=https://bsc-rpc.publicnode.com
COFINEX_BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
COFINEX_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
COFINEX_POLYGON_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
COFINEX_TRON_RPC_URL=https://api.trongrid.io
